# Local development only. Replace both secrets with long random values outside local development.
DATABASE_URL="postgresql://lapis:lapis@localhost:5432/lapis?schema=public"
PORT=3000
LAPIS_ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-characters"
LAPIS_REFRESH_TOKEN_PEPPER="replace-with-at-least-32-random-characters"
LAPIS_MANIFEST_KEY_ID="lapis-production-2026-01"
# Ed25519 private key for API-only manifest signing. Do not commit a production key.
LAPIS_MANIFEST_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# Shared only with the Fabric Bridge on each Minecraft server.
LAPIS_BRIDGE_SHARED_KEY="replace-with-a-long-random-value"
LAPIS_CONTENT_ROOT="V:\\LapisServer\\client-mods"
