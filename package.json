{
  "name": "lapis",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:api": "pnpm --filter @lapis/contracts build && pnpm --filter @lapis/api dev",
    "dev:launcher": "pnpm --filter @lapis/contracts build && pnpm --filter @lapis/minecraft-core build && pnpm --filter @lapis/launcher dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @lapis/api prisma:generate",
    "db:migrate": "pnpm --filter @lapis/api prisma:migrate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
