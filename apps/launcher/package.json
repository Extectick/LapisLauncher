{
  "name": "@lapis/launcher",
  "version": "0.1.1",
  "description": "LapisLauncher for managed Fabric Minecraft builds",
  "author": "Lapis Launcher",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:win": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@lapis/contracts": "workspace:*",
    "@lapis/minecraft-core": "workspace:*",
    "electron-updater": "^6.8.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "skinview3d": "^3.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "ru.lapis.launcher",
    "productName": "LapisLauncher",
    "artifactName": "LapisLauncher-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/update-config.json",
        "to": "update-config.json"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/LapisLauncher"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/public/logo.ico",
      "signtoolOptions": {
        "publisherName": "Lapis Launcher"
      },
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
