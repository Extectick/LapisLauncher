{
  "name": "@lapis/launcher",
  "version": "0.1.4",
  "description": "LapisLauncher for managed Fabric Minecraft builds",
  "author": "Lapis Launcher",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:win": "electron-vite build && electron-builder --win --dir && node scripts/package-velopack.mjs",
    "package:win:release": "node scripts/check-release-signing.mjs && electron-vite build && electron-builder --win --dir && node scripts/package-velopack.mjs --release"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@lapis/contracts": "workspace:*",
    "@lapis/minecraft-core": "workspace:*",
    "electron-log": "5.4.3",
    "velopack": "1.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "skinview3d": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "ru.lapis.launcher",
    "productName": "LapisLauncher",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/@fortawesome/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**",
      "!node_modules/skinview3d/**",
      "!node_modules/three/**",
      "!node_modules/velopack/lib/native/*linux*",
      "!node_modules/velopack/lib/native/*osx*",
      "!node_modules/velopack/lib/native/*arm64*",
      "!node_modules/velopack/lib/native/*x86_msvc*"
    ],
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release/electron"
    },
    "extraResources": [
      {
        "from": "resources/update-config.json",
        "to": "update-config.json"
      }
    ],
    "win": {
      "icon": "src/renderer/public/logo.ico"
    }
  }
}
